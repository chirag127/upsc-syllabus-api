{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chirag127.github.io/upsc-civil-services-syllabus/schemas/data.json",
  "title": "UPSC Civil Services Syllabus",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "status",
      "source"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "source": {
        "type": "string"
      }
    }
  }
}
